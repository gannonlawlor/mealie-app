{
  "manifest_version": 3,
  "name": "Mealie Recipe Saver",
  "version": "1.0.0",
  "description": "Save recipes from any website to your self-hosted Mealie server.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/common.js", "src/background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save recipe to Mealie",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["storage", "activeTab", "contextMenus", "scripting", "notifications"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/detect-core.js", "src/detect.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "mealie-saver@jackabee.com",
      "strict_min_version": "115.0"
    }
  }
}
